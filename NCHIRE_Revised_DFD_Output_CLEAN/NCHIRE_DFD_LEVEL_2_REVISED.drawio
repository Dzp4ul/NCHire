1" parent="1"><mxGeometry x="740" y="1430" width="200" height="54" as="geometry"/></mxCell><mxCell id="l2_p71_store_2_edge" value="Staff notifications" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.4;endArrow=classic;endFill=1;fontFamily=Arial;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;startArrow=classic;startFill=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2_p71" target="l2_p71_store_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2_note" value="&lt;b&gt;Alternative outcomes:&lt;/b&gt; A Secretary replacement request returns the applicant to 4.2. Secretary or Dean rejection records the status and ban, then invokes 7.1. A transferred application continues to 6.1." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;dashed=1;dashPattern=4 4;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="420" y="1040" width="1450" height="105" as="geometry"/></mxCell><mxCell id="l2_erd" value="&lt;b&gt;ERD constraint:&lt;/b&gt; Dynamic-requirement submissions, document versions, and final teaching assignments are implemented in non-ERD tables. They remain disclosed in the report but are not drawn as data stores." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;dashed=1;dashPattern=4 4;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="2120" y="1040" width="1450" height="105" as="geometry"/></mxCell><mxCell id="clean_l2_footer" value="Balanced with Level 1 Processes 4.0–7.0. All review and evaluation decisions are entered by the Applicant, Secretary or Dean." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="2452" width="3840" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
