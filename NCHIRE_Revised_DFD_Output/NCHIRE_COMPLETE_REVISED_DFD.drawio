ry"/></mxCell><mxCell id="c_note1" value="&lt;b&gt;No chatbot data store:&lt;/b&gt; The last eight messages and follow-up context are stored only in the authenticated PHP session. Clearing the conversation unsets those session values." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;dashed=1;dashPattern=4 4;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="680" y="1700" width="1300" height="115" as="geometry"/></mxCell><mxCell id="c_note2" value="&lt;b&gt;Scope boundary:&lt;/b&gt; The assistant reads authorized, role-scoped recruitment records and answers staff questions. It cannot update applicant, teaching-load, application, or workflow records." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1;dashed=1;dashPattern=4 4;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="1700" width="1200" height="115" as="geometry"/></mxCell><mxCell id="dfd_l2_p9_footer" value="Groq connectivity was verified on 22 October 2026. Conversation history remains session-based and is not persisted in a database table." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="2245" width="3540" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
